---
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL, sitePath } from "../config";

const projects = [
  {
    id: "computer-networks",
    repository: "computer-network-labs",
    title: "컴퓨터네트워크 실습 기록",
    type: "수업 실습",
    problem: "허브, 스위치, 라우터가 프레임을 처리하는 방식과 전달 규칙이 통신 경로에 미치는 영향을 확인했습니다.",
    tools: "Python, Mininet, Open vSwitch, OpenFlow, Switchyard",
    method: "허브의 플러딩을 관찰하고, 학습 스위치의 MAC 테이블과 엔트리 제거 정책을 비교했습니다. 라우터의 로컬 ARP 응답과 캐싱을 실습했으며, Mininet 토폴로지에서 컨트롤러 없이 OpenFlow 규칙을 적용했습니다.",
    role: "수업에서 제공한 허브 예제, 테스트, 라우터 뼈대 등을 사용했습니다. AI의 도움으로 과제를 구현하고 문서를 정리했으며, 직접 실험을 실행해 결과를 확인했습니다.",
    result: "OpenFlow 실습 기록에서 의도한 한 쌍의 호스트만 양방향 통신에 성공했습니다. pingall 결과는 방향별 12회 중 2회 수신이었습니다.",
    lesson: "한 실습 환경에서 확인한 결과입니다. 링크 지연 실습의 첫 응답 시간이 길어진 원인으로 ARP를 고려했지만, 별도 캡처로 원인을 확인하지는 않았습니다.",
  },
  {
    id: "password",
    repository: "password-strength-analyzer",
    title: "비밀번호 강도 분석기",
    type: "개인 학습 프로젝트",
    problem: "비밀번호에 강도 등급만 표시하면 어떤 특성이 예측하기 쉬운지 이해하기 어렵습니다.",
    tools: "Python, 표준 라이브러리(getpass)",
    method: "로컬 터미널에서 예시 입력을 숨겨 받아 길이, 문자 종류, 짧은 일반 비밀번호 목록, 연속·반복 패턴을 검사합니다. 입력을 저장하거나 전송하지 않습니다.",
    role: "AI의 도움을 받아 개발했고, 구현을 읽고 이해한 뒤 터미널 테스트와 문제 해결, 학습 내용을 정리했습니다.",
    result: "저장소 테스트 기록에서 흔한 비밀번호와 반복된 알파벳 패턴을 감지하고, 혼합 예시에서 네 가지 문자 유형을 표시했으며, 빈 입력을 거부한 결과를 확인할 수 있습니다.",
    lesson: "작은 목록과 간단한 패턴에 기반한 교육용 도구입니다. 비밀번호 재사용이나 유출 여부는 판정할 수 없습니다. 판정 함수와 입력 처리를 분리하는 방법을 익혔습니다.",
  },
  {
    id: "traffic",
    repository: "network-traffic-analyzer",
    title: "네트워크 트래픽 분석기",
    type: "개인 학습 프로젝트",
    problem: "캡처에 패킷이 많으면 개별 목록만 보고 프로토콜별 분포를 파악하기 어렵습니다.",
    tools: "Python, dpkt, Matplotlib, WSL",
    method: "Ethernet 형식의 classic PCAP을 오프라인에서 읽고 TCP, UDP, ICMP(ICMPv6 포함), ARP, 기타로 분류합니다. 패킷 수, 비율, 캡처 바이트 합계와 평균 크기를 출력하고 PNG 차트를 저장합니다.",
    role: "AI의 도움으로 개발했으며, 구현을 검토하고 WSL에서 합성 캡처 처리, 차트 생성, 잘못된 입력 처리를 확인한 뒤 결과를 기록했습니다.",
    result: "합성 패킷 6개(255바이트)에서 TCP 2개와 나머지 네 범주 각 1개를 확인했습니다. 저장소에는 차트와 파일 입력 오류를 확인한 기록이 있습니다.",
    lesson: "PCAPNG와 Ethernet 이외의 링크 유형은 지원하지 않습니다. 범주별 분포는 캡처의 특성을 설명하며, 그 자체로 침입 여부를 판단할 수는 없습니다.",
  },
  {
    id: "network-security",
    repository: "network-security-labs",
    title: "네트워크 보안 실습 기록",
    type: "수업 실습",
    problem: "평문 통신과 네트워크 상태 변화가 기밀성·무결성·가용성에 어떤 영향을 주는지 관찰했습니다.",
    tools: "VMware, Wireshark, tcpdump, Telnet",
    method: "격리된 가상 네트워크에서 패킷 스니핑과 ARP 주소 매핑, TCP 세션 무결성, 가용성 저하와 관련된 실습 결과를 분석했습니다. 저장소는 실습 문서와 결과 화면으로 구성되어 있습니다.",
    role: "수업에서 제공한 절차와 도구로 실습을 수행하고, 패킷 캡처와 호스트 상태를 비교해 관찰 결과를 문서화했습니다.",
    result: "실습 기록에서 Telnet 테스트 정보가 평문으로 드러났고, 정적 ARP 항목 적용 후 기대한 주소 매핑이 유지됐습니다. 가용성 실습의 UDP 시험에서는 ICMP 손실률이 0%에서 10%로 변했습니다.",
    lesson: "격리된 실습 환경에서 얻은 관찰입니다. 암호화된 관리 접속의 필요성과 캡처·호스트 상태를 함께 확인하는 방법을 배웠습니다.",
  },
];
---

<BaseLayout title="프로젝트" sideBarActiveItemID="projects">
  <div class="prose max-w-none">
    <h1>프로젝트</h1>
    <p>수업에서 수행한 네트워크 실습과 개인 학습용 Python 도구를 정리했습니다.</p>
    <ul>
      {projects.map(({ id, title }) => <li><a href={`#${id}`}>{title}</a></li>)}
    </ul>
    {projects.map((project) => (
      <section id={project.id} class="mt-10 scroll-mt-20 border-t border-base-300 pt-6">
        <h2 class="mt-0">{project.title}</h2>
        <p class="text-sm font-semibold">{project.type}</p>
        <dl class="grid gap-3">
          {[
            ["목적과 문제", project.problem],
            ["사용 기술", project.tools],
            ["수행 내용", project.method],
            ["역할과 기여", project.role],
            ["기록된 결과", project.result],
            ["한계와 배운 점", project.lesson],
          ].map(([label, description]) => (
            <div>
              <dt class="font-bold">{label}</dt>
              <dd class="ml-0">{description}</dd>
            </div>
          ))}
        </dl>
        {project.id === "traffic" && (
          <figure>
            <img src={sitePath("images/protocols.png")} width="700" height="400" loading="lazy"
              alt="합성 캡처의 프로토콜 분포. TCP 2개, UDP, ICMP, ARP, 기타 각 1개." />
            <figcaption>저장소에 기록된 합성 PCAP 분석 결과</figcaption>
          </figure>
        )}
        <a href={`${GITHUB_URL}/${project.repository}`}>GitHub 저장소 보기<span class="sr-only"> — {project.title}</span></a>
      </section>
    ))}
  </div>
</BaseLayout>
