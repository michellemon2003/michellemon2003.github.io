---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../config";
import { projects } from "../projects";
---
<BaseLayout title="프로젝트" sideBarActiveItemID="projects">
  <header class="page-intro"><h1>프로젝트</h1><p>Python으로 만든 개인 학습 도구와 네트워크 수업에서 수행한 실험을 정리했습니다.</p></header>
  {["개인 학습 프로젝트", "수업 실습"].map(type => (
    <section class="portfolio-section"><h2>{type}</h2>
      <div class="project-grid">
      {projects.filter(project => project.type === type).map(project => (
        <article class="project-card" id={project.id}>
          <h3><a href={sitePath(`projects/${project.id}/`)}>{project.title}</a></h3>
          <p class="tech">{project.tools}</p>
          <p>{project.problem}</p><p>{project.result}</p>
          <a class="detail" href={sitePath(`projects/${project.id}/`)}>구현과 결과 보기 <span aria-hidden="true">↗</span></a>
        </article>
      ))}
      </div>
    </section>
  ))}
</BaseLayout>
